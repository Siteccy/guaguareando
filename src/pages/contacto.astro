---
// textos: rama design (contact.html), sin formulario - el contacto es por correo, WhatsApp y redes
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import StopSign from '../components/StopSign.astro';
import { site, socials, mailtoLink, whatsappLink } from '../data/site';
// ilustracion animada del encabezado, va como <img> para que su CSS y sus id queden aislados de la pagina
import ilustracion from '../assets/svg_animados/contacto-hero.svg?url';

const motivos = [
  {
    title: 'Historias y colaboraciones',
    text: '¿Quieres participar, proponer un tema o compartir una experiencia? Cuéntanos tu idea por correo o por WhatsApp.',
  },
  {
    title: 'Pautas publicitarias',
    text: 'Si representas una marca, un negocio o una iniciativa, podemos conversar sobre posibles espacios de difusión.',
    href: '/anunciate',
    link: 'Conocer las opciones de pauta',
  },
  {
    title: 'Conoce nuestros contenidos',
    text: 'También puedes descubrir nuestros programas y publicaciones digitales.',
    href: '/programas',
    link: 'Explorar los programas',
  },
];
---

<BaseLayout
  title="Contacto"
  description="Escríbele a Guaguareando Ando por correo o WhatsApp, o síguenos en Instagram, Facebook, YouTube, TikTok y Spotify. Comparte tu historia, propón una colaboración o pregunta por pautas."
>
  <PageHead
    letrero="Estamos para escucharte"
    title="¡Hablemos y sigamos guaguareando!"
    lead="¿Tienes una historia que compartir, una propuesta de colaboración o una consulta? Nos encantará conocerte y escuchar tus ideas."
  >
    <img
      slot="aside"
      src={ilustracion}
      alt="Combi estacionada con la puerta abierta recibiendo un mensaje"
      width="560"
      height="560"
    />
  </PageHead>

  <!-- canales directos -->
  <section class="bloque" aria-labelledby="canales-titulo">
    <div class="wrap">
      <StopSign text="Ponte en contacto" sinMarcador />
      <h2 id="canales-titulo" class="bloque__titulo">Tu mensaje es importante para nosotros</h2>
      <p class="bloque__lead">
        Guaguareando Ando es un espacio abierto para compartir experiencias, conocimientos y nuevas perspectivas.
        Escríbenos para conversar sobre tu propuesta.
      </p>

      <ul role="list" class="canales">
        <li>
          <a href={mailtoLink()} class="canal canal--correo">
            <span class="canal__icono"><Icon name="mail" size={30} /></span>
            <span class="canal__tipo">Correo</span>
            <span class="canal__dato">{site.email}</span>
          </a>
        </li>
        <li>
          <a href={whatsappLink('Hola, Guaguareando Ando.')} class="canal canal--whatsapp" target="_blank" rel="noopener noreferrer">
            <span class="canal__icono"><Icon name="brand-whatsapp" size={30} /></span>
            <span class="canal__tipo">WhatsApp</span>
            <span class="canal__dato">{site.whatsapp.display}</span>
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        </li>
      </ul>
      <p class="ubicacion">
        <Icon name="map-pin" size={20} />
        {site.location}
      </p>
    </div>
  </section>

  <!-- redes -->
  <section class="bloque bloque--noche oscuro" aria-labelledby="redes-titulo">
    <div class="wrap">
      <StopSign text="Síguenos" sinMarcador />
      <h2 id="redes-titulo" class="bloque__titulo">Guaguarones y Guaguaronas, nos vemos en redes</h2>
      <ul role="list" class="redes">
        {
          socials.map((red) => (
            <li>
              <a href={red.url} class="red" target="_blank" rel="noopener noreferrer">
                <Icon name={`brand-${red.id}` as const} size={30} />
                <span class="red__nombre">{red.label}</span>
                <span class="red__handle">{red.handle}</span>
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- motivos -->
  <section class="bloque" aria-labelledby="motivos-titulo">
    <div class="wrap">
      <h2 id="motivos-titulo" class="bloque__titulo">¿De qué quieres platicar?</h2>
      <ul role="list" class="motivos">
        {
          motivos.map((m) => (
            <li class="motivo">
              <h3 class="motivo__titulo">{m.title}</h3>
              <p>{m.text}</p>
              {m.href && (
                <a href={m.href} class="motivo__link">
                  {m.link}
                  <Icon name="arrow-right" size={18} />
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .bloque {
    padding-block: var(--space-2xl);
  }

  .bloque--noche {
    background: var(--azul-noche);
  }

  .bloque__titulo {
    max-width: 22ch;
    font-size: var(--step-4);
    font-weight: 700;
  }

  .bloque__lead {
    max-width: 40rem;
    margin-top: var(--space-s);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  /* correo y WhatsApp: tarjetas grandes */
  .canales {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-xl);
  }

  @media (min-width: 48rem) {
    .canales {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .canal {
    display: grid;
    gap: var(--space-2xs);
    height: 100%;
    padding: var(--space-l) var(--space-m);
    border-radius: var(--radius-l);
    color: var(--blanco);
    text-decoration: none;
    box-shadow: var(--sombra-alta);
    transition: transform var(--dur) var(--ease-out);
  }

  .canal:hover {
    transform: translateY(-3px);
  }

  .canal--correo {
    background: var(--naranja-accion);
  }

  /* un solo color fuerte por seccion: el naranja es del correo, WhatsApp va en azul noche (neutro) */
  .canal--whatsapp {
    background: var(--azul-noche);
  }

  .canal__icono {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--space-xs);
    border-radius: 50%;
    background: var(--blanco);
    color: var(--tinta);
  }

  .canal__tipo {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .canal__dato {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .canal:focus-visible {
    outline-color: var(--tinta);
  }

  .ubicacion {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: var(--space-m);
    color: var(--tinta-suave);
    font-weight: 600;
  }

  /* redes */
  .redes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-s);
    margin-top: var(--space-xl);
  }

  /* icono a la izquierda, nombre y usuario a la derecha, en una sola linea cada uno */
  .red {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: var(--space-s);
    height: 100%;
    padding: var(--space-m);
    border: 2px solid var(--linea-oscura);
    border-radius: var(--radius-m);
    color: var(--crema);
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .red:hover {
    border-color: var(--naranja-accion);
    background: var(--naranja-accion);
  }

  .red :global(svg) {
    grid-row: 1 / 3;
  }

  .red__nombre {
    align-self: end;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
  }

  .red__handle {
    align-self: start;
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }

  /* motivos */
  .motivos {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-xl);
  }

  @media (min-width: 56rem) {
    .motivos {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .motivo {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding: var(--space-l) var(--space-m);
    border: 2px dashed var(--linea);
    border-radius: var(--radius-m);
  }

  .motivo__titulo {
    color: var(--azul-combi);
    font-size: var(--step-2);
    font-weight: 700;
  }

  .motivo__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--naranja-accion);
    font-weight: 700;
  }
</style>
