---
// la combi del logo vista desde arriba: carroceria azul, techo blanco y las maletas en la parrilla
// va de frente hacia abajo (avanza por la ruta conforme se baja en la pagina)
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className } = Astro.props;
---

<svg
  class:list={['combi', className]}
  width={size}
  height={size * (80 / 48)}
  viewBox="0 0 48 80"
  aria-hidden="true"
  focusable="false"
>
  <!-- llantas -->
  <rect x="1" y="12" width="7" height="14" rx="3" fill="#0b0f2a" />
  <rect x="40" y="12" width="7" height="14" rx="3" fill="#0b0f2a" />
  <rect x="1" y="54" width="7" height="14" rx="3" fill="#0b0f2a" />
  <rect x="40" y="54" width="7" height="14" rx="3" fill="#0b0f2a" />
  <!-- carroceria -->
  <rect x="4" y="3" width="40" height="74" rx="13" fill="#3f6ea8" />
  <rect x="4" y="60" width="40" height="17" rx="10" fill="#2f5a8f" />
  <!-- techo blanco -->
  <rect x="8" y="8" width="32" height="52" rx="9" fill="#f7f3ee" />
  <!-- parabrisas (frente, abajo) -->
  <rect x="9" y="63" width="30" height="8" rx="4" fill="#bfd5ef" />
  <!-- faros -->
  <circle cx="11" cy="74.5" r="2" fill="#fff1bf" />
  <circle cx="37" cy="74.5" r="2" fill="#fff1bf" />
  <!-- parrilla del techo -->
  <rect x="11" y="12" width="26" height="45" rx="4" fill="none" stroke="#9aa3b5" stroke-width="1.6" />
  <!-- maletas -->
  <rect x="12.5" y="13.5" width="23" height="16" rx="7" fill="#d95f0e" />
  <path d="M18 14v15M24 14v15M30 14v15" stroke="#a8480b" stroke-width="1.4" />
  <rect x="13" y="32" width="11" height="13" rx="3.5" fill="#4f7fbd" />
  <rect x="15.5" y="34.5" width="6" height="3" rx="1.5" fill="#2f5a8f" />
  <rect x="25.5" y="32" width="10" height="10" rx="3.5" fill="#e9a3bd" />
  <rect x="14" y="47.5" width="9" height="7.5" rx="2.5" fill="#f2c94c" />
  <rect x="25" y="44.5" width="10" height="10.5" rx="3" fill="#d95f0e" />
  <path d="M25.5 49.5h9" stroke="#a8480b" stroke-width="1.4" />
</svg>
