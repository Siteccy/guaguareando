---
// sello circular girado, como de pasaporte o boleto: anuncia una cita fija ("En vivo · martes 8:00 pm")
interface Props {
  /** texto que corre alrededor del sello */
  ring: string;
  /** linea grande del centro */
  big: string;
  /** linea pequeña del centro */
  small: string;
  class?: string;
}

const { ring, big, small, class: className } = Astro.props;
const pathId = `sello-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['sello', className]} role="img" aria-label={`${ring}: ${big} ${small}`}>
  <svg viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <defs>
      <path id={pathId} d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" />
    </defs>
    <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="4" />
    <circle cx="100" cy="100" r="58" fill="none" stroke="currentColor" stroke-width="2.5" />
    <text class="sello__ring">
      <textPath href={`#${pathId}`} startOffset="0">{ring}</textPath>
    </text>
    <text x="100" y="98" text-anchor="middle" class="sello__big">{big}</text>
    <text x="100" y="124" text-anchor="middle" class="sello__small">{small}</text>
  </svg>
</div>

<style>
  .sello {
    width: clamp(9rem, 7rem + 8vw, 12rem);
    aspect-ratio: 1;
    color: var(--crema);
    rotate: -12deg;
  }

  .sello svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .sello text {
    fill: currentColor;
    font-family: var(--font-display);
    font-weight: 700;
  }

  .sello__ring {
    font-size: 19px;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .sello__big {
    font-size: 30px;
  }

  .sello__small {
    font-size: 17px;
    letter-spacing: 1px;
  }
</style>
